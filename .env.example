# Copy to .env.local and fill in to switch Synthos OS from local mode to the
# shared Supabase backend (Postgres + Storage + Auth). Leave blank to keep
# running fully locally (localStorage + IndexedDB).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push (production only — set these in the Vercel dashboard, not here).
# The serverless functions in api/ need them; generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT=mailto:team@runsynthos.com

# Server-triggered pushes (api/notify-message.js + api/remind.js):
# PUSH_WEBHOOK_SECRET=   # shared with the Postgres trigger (schema.sql)
# SUPABASE_SERVICE_ROLE_KEY=   # dashboard → Settings → API — server-only, never in the client
# CRON_SECRET=   # optional; Vercel sends it with the daily /api/remind cron
