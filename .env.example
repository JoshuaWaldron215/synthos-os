# Copy to .env.local and fill in to switch Synthos OS from local mode to the
# shared Supabase backend (Postgres + Storage + Auth). Leave blank to keep
# running fully locally (localStorage + IndexedDB).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push (production only — set these in the Vercel dashboard, not here).
# The serverless functions in api/ need them; generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT=mailto:team@synthos.dev
